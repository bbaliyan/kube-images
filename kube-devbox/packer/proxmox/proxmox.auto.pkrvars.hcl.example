# Copy to proxmox.auto.pkrvars.hcl and set the real values there. That file is not committed.
# Do not set the Proxmox URL or the API token here. build.sh takes them from ~/.kube-compute/.

proxmox_node        = "pve"
seed_template_vm_id = 9000
disk_datastore_id   = "local-zfs"
network_bridge      = "vmbr0"
